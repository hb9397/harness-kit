#!/usr/bin/env python3
"""Muse PreToolUse adapter for portable artifact routing.

Muse invokes the hook as a fixed ``command`` with the event payload on stdin
and ``cwd`` set to the project root. This adapter mirrors the shared routing
contract in ``hooks/artifact-route-core.ps1.template`` for the ``muse`` host:
project containment, canonical-document and app-source allowlists, the
external default-path denial, and exact one-shot approval markers for new
managed artifacts.

Verdicts follow the observed Muse mapping: exit 0 with empty stdout allows,
exit 0 with a ``hookSpecificOutput.permissionDecision=deny`` object denies,
and any failure closes the gate with the same deny object (fail-closed).
A nonzero exit would also block, but an untested hook must never be approved,
so this adapter always exits 0.
"""

from __future__ import annotations

import hashlib
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

WRITE_TOOLS = ("write_file", "edit_file")
CONTENT_KEYS = ("content", "new_string")
PATH_KEYS = ("path", "file_path", "target_path")


def deny(reason):
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "deny",
                    "permissionDecisionReason": reason,
                }
            },
            ensure_ascii=False,
        )
    )
    return 0


def allow():
    return 0


def read_payload():
    try:
        text = sys.stdin.buffer.read().decode("utf-8-sig")
    except (ValueError, OSError):
        return None
    if not text.strip():
        return None
    try:
        payload = json.loads(text)
    except ValueError:
        return None
    return payload if isinstance(payload, dict) else None


def tool_leaf(name):
    return str(name or "").split(".")[-1]


def input_text(tool_input, keys):
    for key in keys:
        value = tool_input.get(key)
        if value is None:
            continue
        if isinstance(value, str) and value:
            return value
    return None


def content_hash(tool_input):
    text = input_text(tool_input, CONTENT_KEYS)
    if text is None:
        edits = tool_input.get("edits")
        text = json.dumps(edits, ensure_ascii=False, sort_keys=True) if edits is not None else ""
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def normalize(path_value, base):
    if path_value is None or not str(path_value).strip():
        return None
    candidate = str(path_value).strip().replace("/", os.sep)
    if not os.path.isabs(candidate):
        candidate = os.path.join(base, candidate)
    try:
        return os.path.normpath(candidate)
    except (ValueError, OSError):
        return None


def contained(candidate, root):
    root_norm = os.path.normcase(os.path.normpath(root))
    cand_norm = os.path.normcase(os.path.normpath(candidate))
    return cand_norm == root_norm or cand_norm.startswith(root_norm + os.sep)


def find_routing(start):
    current = os.path.abspath(start)
    while True:
        candidate = os.path.join(current, ".ai-docs", "harness", "artifact-routing.json")
        if os.path.isfile(candidate):
            return os.path.abspath(current), candidate
        parent = os.path.dirname(current)
        if parent == current:
            return None, None
        current = parent


def marker_match(marker_dir, relative, content_sha):
    if not os.path.isdir(marker_dir):
        return None
    try:
        names = sorted(os.listdir(marker_dir))
    except OSError:
        return None
    now = datetime.now(timezone.utc)
    for name in names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(marker_dir, name)
        try:
            with open(path, "r", encoding="utf-8") as handle:
                marker = json.load(handle)
        except (ValueError, OSError):
            continue
        if not isinstance(marker, dict):
            continue
        if marker.get("operation") != "write":
            continue
        if marker.get("target_path") != relative:
            continue
        if marker.get("content_sha256") != content_sha:
            continue
        try:
            expires = datetime.fromisoformat(str(marker.get("expires_at", "")).replace("Z", "+00:00"))
        except ValueError:
            continue
        if expires.tzinfo is None:
            expires = expires.replace(tzinfo=timezone.utc)
        if expires <= now:
            continue
        return path
    return None


def route(project, routing, tool_name, tool_input):
    docs_root = os.path.join(project, ".ai-docs")
    inbox_root = os.path.join(docs_root, "_inbox")
    write_guard = routing.get("write_guard", {}) if isinstance(routing, dict) else {}
    marker_dir = os.path.join(project, str(write_guard.get("approval_marker_directory", ".ai-docs/.harness/artifact-approvals")).replace("/", os.sep))
    apps = routing.get("apps", []) if isinstance(routing, dict) else []
    source_roots = []
    for app in apps:
        if isinstance(app, dict) and app.get("source_root"):
            root = normalize(app.get("source_root"), project)
            if root:
                source_roots.append(root)
    exception_roots = []
    for entry in routing.get("write_exceptions", []) if isinstance(routing, dict) else []:
        root = normalize(entry, project)
        if root:
            exception_roots.append(root)
    forbidden_roots = [
        os.path.join(project, "docs", "superpowers", "specs"),
        os.path.join(project, "docs", "superpowers", "plans"),
    ]
    canonical_instruction = ""
    if apps and isinstance(apps[0], dict):
        canonical_instruction = str(apps[0].get("routing_instruction", ""))
    allowed_root_files = [os.path.join(project, "AGENTS.md")]

    raw_path = input_text(tool_input, PATH_KEYS)
    target = normalize(raw_path, project)
    if target is None or not contained(target, project):
        return deny("target is outside project containment: " + str(raw_path))
    relative = os.path.relpath(target, project).replace(os.sep, "/")
    exists = os.path.isfile(target)
    is_root_context = any(os.path.normcase(target) == os.path.normcase(item) for item in allowed_root_files)
    is_source = any(contained(target, root) for root in source_roots)
    is_inbox = contained(target, inbox_root)
    is_docs = contained(target, docs_root)
    is_exception = any(contained(target, root) for root in exception_roots)

    if any(contained(target, root) for root in forbidden_roots):
        return deny("external default path is not canonical; use " + canonical_instruction + " to calculate the target")
    if is_inbox or is_exception:
        return allow()
    if (is_docs or is_root_context) and exists:
        return allow()
    if is_docs or is_root_context:
        marker = marker_match(marker_dir, relative, content_hash(tool_input))
        if marker is None:
            return deny("new managed artifact requires an exact one-shot approval marker: " + relative)
        try:
            os.remove(marker)
        except OSError:
            return deny("approval marker could not be consumed: " + relative)
        return allow()
    if is_source:
        return allow()
    return deny("target is not an approved app source, canonical document, inbox, or declared exception: " + relative)


def main():
    payload = read_payload()
    if payload is None:
        return deny("muse-routing: unreadable PreToolUse payload")
    if payload.get("hook_event_name") != "PreToolUse":
        return allow()
    if tool_leaf(payload.get("tool_name")) not in WRITE_TOOLS:
        return allow()
    tool_input = payload.get("tool_input")
    if not isinstance(tool_input, dict):
        return deny("muse-routing: PreToolUse write without tool input")
    cwd = payload.get("cwd")
    starts = []
    if isinstance(cwd, str) and os.path.isdir(cwd):
        starts.append(cwd)
    starts.append(os.getcwd())
    starts.append(os.path.dirname(os.path.abspath(__file__)))
    project = None
    routing = None
    for start in starts:
        project, routing_path = find_routing(start)
        if project is None:
            continue
        try:
            with open(routing_path, "r", encoding="utf-8") as handle:
                routing = json.load(handle)
        except (ValueError, OSError):
            project = None
            continue
        break
    if project is None or not isinstance(routing, dict):
        return deny("muse-routing: portable routing contract is missing")
    if not isinstance(routing.get("hosts"), dict) or "muse" not in routing["hosts"]:
        return deny("muse-routing: unsupported routing host: muse")
    try:
        return route(project, routing, tool_leaf(payload.get("tool_name")), tool_input)
    except Exception:
        return deny("muse-routing: routing evaluation failed")


if __name__ == "__main__":
    raise SystemExit(main())
