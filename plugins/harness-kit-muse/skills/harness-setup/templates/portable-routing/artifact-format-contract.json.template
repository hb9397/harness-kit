{
  "schema_version": "1.0.0",
  "kind": "artifact-format-contract",
  "routing_schema": ".ai-docs/harness/artifact-routing.json",
  "required_fields": [
    "artifact_id",
    "artifact_type",
    "owner",
    "app_id",
    "target_path",
    "source_context",
    "created_at"
  ],
  "path_rules": {
    "target_path": "must be a normalized project-relative path under the app source or docs root declared in artifact-routing.json",
    "prototype": "must remain under the declared prototype_owner",
    "context": "must cite the declared canonical_context or routing_instruction"
  },
  "provenance": {
    "required": true,
    "fields": ["producer", "input_fingerprint", "source_context"]
  },
  "inbox": {
    "manifest_path": ".ai-docs/_inbox/artifact-manifest.json",
    "canonicalization": "proposal only; do not replace a canonical artifact without explicit approval"
  },
  "normalization": {
    "text_extensions": [".md", ".mdx", ".txt", ".rst", ".adoc", ".asciidoc"],
    "text_rule": "UTF-8 newline normalization and marker-aware three-way proposal; G12 approval is required before promotion",
    "fixed_format_extensions": [".json", ".yaml", ".yml", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".pdf"],
    "fixed_format_rule": "record source hash and proposal in _inbox only; no lossy automatic conversion or canonical promotion"
  }
}
