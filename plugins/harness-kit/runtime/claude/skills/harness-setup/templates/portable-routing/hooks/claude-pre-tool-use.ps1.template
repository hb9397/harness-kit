[CmdletBinding()]
param()

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$raw = [Console]::In.ReadToEnd()
if ([string]::IsNullOrWhiteSpace($raw)) {
    [Console]::Error.WriteLine('Claude PreToolUse payload is required.')
    exit 2
}

$payload = $raw | ConvertFrom-Json
if ([string]::IsNullOrWhiteSpace([string]$payload.tool_name) -or $null -eq $payload.tool_input) {
    [Console]::Error.WriteLine('Claude PreToolUse requires tool_name and tool_input.')
    exit 2
}
$commandProperty = $payload.tool_input.PSObject.Properties['command']
if ($null -ne $commandProperty -and $null -ne $commandProperty.Value) {
    [Console]::Error.WriteLine('Codex tool_input.command payload cannot be used by the Claude adapter.')
    exit 2
}
if ([string]::IsNullOrWhiteSpace($env:CLAUDE_PROJECT_DIR)) {
    [Console]::Error.WriteLine('CLAUDE_PROJECT_DIR is required by the Claude project adapter.')
    exit 2
}

$corePath = Join-Path $env:CLAUDE_PROJECT_DIR '.ai-docs/harness/hooks/artifact-route-core.ps1'
try {
    $decision = (& $corePath -RuntimeHost claude -ProjectRoot $env:CLAUDE_PROJECT_DIR -ToolName $payload.tool_name -ToolInput $payload.tool_input | ConvertFrom-Json)
} catch {
    [Console]::Error.WriteLine("Claude routing guard failed: $($_.Exception.Message)")
    exit 2
}
if ($decision.decision -eq 'deny') {
    [Console]::Error.WriteLine("Claude routing guard denied: $($decision.reason)")
    exit 2
}
# Allow emits nothing: Claude validates exit 0 JSON and rejects the internal routing object.
exit 0
