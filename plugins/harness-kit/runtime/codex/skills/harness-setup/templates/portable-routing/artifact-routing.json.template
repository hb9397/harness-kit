{
  "schema_version": "1.2.0",
  "kind": "portable-artifact-routing",
  "project_root": ".",
  "mode": "{{PROJECT_MODE}}",
  "setup": {
    "project_owned_bundle": true,
    "local_state_path": ".ai-docs/.harness/routing-state.local.json"
  },
  "apps": [
    {
      "id": "{{APP_ID}}",
      "source_root": "{{APP_SOURCE_ROOT}}",
      "docs_root": "{{APP_DOCS_ROOT}}",
      "prototype_owner": "{{PROTOTYPE_OWNER}}",
      "canonical_context": "{{CANONICAL_CONTEXT}}",
      "routing_instruction": "{{ROUTING_INSTRUCTION}}"
    }
  ],
  "repositories": {{REPOSITORY_ENTRIES}},
  "write_guard": {
    "approval_marker_directory": ".ai-docs/.harness/artifact-approvals",
    "one_shot_marker_ttl_seconds": 900,
    "dynamic_shell_target": "bypass-with-evidence"
  },
  "write_exceptions": [],
  "hosts": {
    "claude": {
      "layer": 3,
      "config_path": ".claude/settings.json",
      "adapter_path": ".claude/hooks/claude-pre-tool-use.ps1"
    },
    "codex": {
      "layer": 3,
      "config_path": ".codex/hooks.json",
      "adapter_path": ".codex/hooks/codex-pre-tool-use.ps1"
    }
  },
  "managed_files": [
    ".ai-docs/harness/artifact-routing.json",
    ".ai-docs/harness/artifact-format-contract.json",
    ".ai-docs/harness/README.md",
    ".ai-docs/harness/install-routing.ps1",
    ".ai-docs/harness/normalize-artifact.ps1",
    ".ai-docs/harness/hooks/artifact-route-core.ps1",
    ".ai-docs/harness/hooks/claude-pre-tool-use.ps1",
    ".ai-docs/harness/hooks/codex-pre-tool-use.ps1",
    ".ai-docs/harness/hooks/approve-artifact.ps1",
    ".claude/settings.json",
    ".claude/hooks/claude-pre-tool-use.ps1",
    ".codex/hooks.json",
    ".codex/hooks/codex-pre-tool-use.ps1"
  ]
}
